{{template "header" .Title}}
<body>
    {{template "nav" . }}

    <main class="auth-page">
        <section class="auth-card auth-card--signup" aria-labelledby="auth-title">
            <div class="auth-card__aside">
                <a class="auth-card__brand" href="index.html">The Hub</a>
                <div>
                    <span class="auth-card__eyebrow">A clearer view of uni</span>
                    <h2>Your course, commitments and communities — all connected.</h2>
                </div>
                <p>Set up your student profile to make The Hub yours.</p>
            </div>

            <div class="auth-card__content">
                <span class="eyebrow">Get started</span>
                <h1 id="auth-title">Create your account</h1>
                <p class="auth-card__description">A few details to get your student hub set up.</p>

                <form class="auth-form auth-form--signup" method="post" data-auth-form>
                    <label class="auth-field">
                        <span>Your name</span>
                        <input type="text" name="name" autocomplete="name" placeholder="e.g. Alex Morgan" required>
                    </label>

                    <label class="auth-field">
                        <span>Email address</span>
                        <input type="email" name="email" autocomplete="email" placeholder="you@university.ac.uk" required>
                    </label>

                    <label class="auth-field">
                        <span>Password</span>
                        <input type="password" name="password" autocomplete="new-password" minlength="8" placeholder="At least 8 characters" required>
                    </label>

                    <label class="auth-field">
                        <span>University</span>
                        <select name="university" required>
                            <option value="" disabled selected>Select your university</option>
                            <optgroup label="England">
                                <option>University of Bath</option>
                                <option>University of Birmingham</option>
                                <option>University of Bristol</option>
                                <option>University of Cambridge</option>
                                <option>Durham University</option>
                                <option>University of Exeter</option>
                                <option>University of Leeds</option>
                                <option>University of Liverpool</option>
                                <option>University of Manchester</option>
                                <option>Newcastle University</option>
                                <option>University of Nottingham</option>
                                <option>University of Oxford</option>
                                <option>Queen Mary University of London</option>
                                <option>University of Sheffield</option>
                                <option>University of Southampton</option>
                                <option>University of Warwick</option>
                                <option>University of York</option>
                                <option>Imperial College London</option>
                                <option>King's College London</option>
                                <option>University College London</option>
                            </optgroup>
                            <optgroup label="Scotland">
                                <option>University of Aberdeen</option>
                                <option>University of Dundee</option>
                                <option>University of Edinburgh</option>
                                <option>University of Glasgow</option>
                                <option>University of St Andrews</option>
                                <option>University of Strathclyde</option>
                            </optgroup>
                            <optgroup label="Wales">
                                <option>Cardiff University</option>
                                <option>Swansea University</option>
                                <option>Bangor University</option>
                                <option>Aberystwyth University</option>
                            </optgroup>
                            <optgroup label="Northern Ireland">
                                <option>Queen's University Belfast</option>
                                <option>Ulster University</option>
                            </optgroup>
                            <option>Another UK university</option>
                        </select>
                    </label>

                    <label class="auth-field">
                        <span>Course</span>
                        <select name="course" required>
                            <option value="" disabled selected>Select your course</option>
                            <optgroup label="Computing and technology">
                                <option>Computer Science</option>
                                <option>Artificial Intelligence</option>
                                <option>Cyber Security</option>
                                <option>Data Science</option>
                                <option>Electronic and Information Engineering</option>
                                <option>Software Engineering</option>
                            </optgroup>
                            <optgroup label="Engineering and sciences">
                                <option>Biological Sciences</option>
                                <option>Biomedical Science</option>
                                <option>Chemistry</option>
                                <option>Civil Engineering</option>
                                <option>Mathematics</option>
                                <option>Mechanical Engineering</option>
                                <option>Medicine</option>
                                <option>Physics</option>
                                <option>Psychology</option>
                            </optgroup>
                            <optgroup label="Arts, humanities and social sciences">
                                <option>Architecture</option>
                                <option>Business Management</option>
                                <option>Economics</option>
                                <option>Education</option>
                                <option>English Literature</option>
                                <option>History</option>
                                <option>Law</option>
                                <option>Politics and International Relations</option>
                            </optgroup>
                            <option>Another course</option>
                        </select>
                    </label>

                    <button class="button button--primary auth-form__submit" type="submit">Create account</button>
                    <p class="auth-form__message" data-auth-message role="status" aria-live="polite" hidden></p>
                </form>

                <p class="auth-card__switch">Already have an account? <a href="login.html">Log in</a></p>
            </div>
        </section>
    </main>

    <script src="assets/js/auth-forms.js" defer></script>
{{template "footer" . }}
